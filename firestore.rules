rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Admins: signed in with Google using one of these emails. Keep in sync with
    // src/auth/admins.ts and storage.rules.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'fabriciocpacheco@gmail.com',
          'oreiastreamer@gmail.com'
        ];
    }

    // Whole app state lives in this one document. Anyone with the link can follow the
    // tournaments live; only admins can change them.
    match /app/tournaments {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
