rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Whole app state lives in this one document. Open read/write on purpose — there's no
    // login system yet, and anyone with the link is meant to be able to follow and run the
    // tournament. Revisit this if the app ever needs to restrict who can edit results.
    match /app/tournaments {
      allow read, write: if true;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
