rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Sponsor logos. Same posture as firestore.rules: open on purpose, no login system yet.
    match /sponsors/{allPaths=**} {
      allow read, write: if true;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
